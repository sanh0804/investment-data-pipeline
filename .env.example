POSTGRES_DB=investment
POSTGRES_USER=investment
POSTGRES_PASSWORD=replace_with_a_local_random_password
POSTGRES_HOST=127.0.0.1
# Avoid the common host PostgreSQL port 5432.
POSTGRES_PORT=55432

# UTC dates: inclusive start, exclusive end; omit both for last 180 completed days.
START_DATE=2026-05-01
END_DATE=2026-10-28
PRODUCTS=BTC-USD,ETH-USD,SOL-USD
# <=299 allows one inclusive-end candle within the provider's 300-candle limit.
REQUEST_CHUNK_DAYS=60
HTTP_REQUEST_INTERVAL=1
HTTP_CONNECT_TIMEOUT=5
HTTP_READ_TIMEOUT=20
HTTP_MAX_ATTEMPTS=3
HTTP_BACKOFF_SECONDS=1
HTTP_MAX_RETRY_DELAY=30

# dbt wrapper reads POSTGRES_* above; credentials stay in env.
DBT_SCHEMA=analytics
# Optional DBT_DATABASE overrides POSTGRES_DB for dbt only.
# Test PostgreSQL uses a separate server with tmpfs, never the demo volume.
TEST_POSTGRES_PORT=55433

# Stage 3: local dashboard. Replace placeholders; never commit .env.
METABASE_PORT=3000
METABASE_DB_PASSWORD=replace_with_a_different_random_password
METABASE_ENCRYPTION_KEY=replace_with_a_random_key_at_least_32_characters
METABASE_READER_PASSWORD=replace_with_another_random_password
METABASE_ADMIN_EMAIL=admin@investment.local
METABASE_ADMIN_PASSWORD=replace_with_a_strong_local_password

# Optional Airflow overlay; init_airflow_env.py fills these locally.
AIRFLOW_PORT=8081
AIRFLOW_METADATA_PASSWORD=replace_with_urlsafe_random_password
AIRFLOW_COLLECTOR_PASSWORD=replace_with_random_collector_password
AIRFLOW_FERNET_KEY=replace_with_generated_fernet_key
AIRFLOW_JWT_SECRET=replace_with_random_jwt_secret
AIRFLOW_LOCAL_ADMIN_USER=sanh
AIRFLOW_LOCAL_ADMIN_PASSWORD=replace_with_random_ui_password
