POSTGRES_DB=investment
POSTGRES_USER=investment
POSTGRES_PASSWORD=replace_with_a_local_random_password
POSTGRES_HOST=127.0.0.1
# Avoid the common host PostgreSQL port 5432.
POSTGRES_PORT=55432

# UTC dates: inclusive start, exclusive end; omit both for last 180 completed days.
START_DATE=2026-05-01
END_DATE=2026-10-28
PRODUCTS=BTC-USD,ETH-USD,SOL-USD
# <=299 allows one inclusive-end candle within the provider's 300-candle limit.
REQUEST_CHUNK_DAYS=60
HTTP_REQUEST_INTERVAL=1
HTTP_CONNECT_TIMEOUT=5
HTTP_READ_TIMEOUT=20
HTTP_MAX_ATTEMPTS=3
HTTP_BACKOFF_SECONDS=1
HTTP_MAX_RETRY_DELAY=30
